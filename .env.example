# Configurações de API
# Para desenvolvimento local
VITE_API_URL=http://localhost:8080/verly-service

# Para produção
# VITE_API_URL=https://api.verlyvidracaria.com/verly-service

# Rota inicial pós-login (default: /products)
VITE_POST_LOGIN_REDIRECT=/leads

# Outras configurações podem ser adicionadas aqui conforme necessário

# Feature flags de build (src/lib/flags.ts). Padrão: desligada.
# Só liga com o valor exato 'true'; qualquer outro valor (ou ausência) = desligada.
# Mudança exige novo build: a flag é lida do ambiente de build, não em runtime.
# VITE_FLAG_PIX_ORDER_LINK=true        # Pix: vincular comprovante ao pedido
# VITE_FLAG_PIX_DISMISS=true           # Pix: marcar comprovante como "não é pagamento"
# VITE_FLAG_LIVE_EVENTS=true           # Eventos ao vivo (SSE do dashboard)
# VITE_FLAG_LEAD_SNOOZE=true           # Leads: adiar lead
# VITE_FLAG_LEAD_LOST_REASON=true      # Leads: motivo de perda
# VITE_FLAG_INSTALLATION_SCHEDULE=true # Agenda de instalação
# VITE_FLAG_MOBILE_SHELL=true          # Shell do app mobile
